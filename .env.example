# Endereço HTTP da aplicação
HTTP_ADDR=:8080

# String de conexão PostgreSQL
DATABASE_URL=postgres://srm:srm@localhost:5432/srm?sslmode=disable

# Nível de log (debug, info, warn, error)
LOG_LEVEL=info

# URL do provedor de cotação externo (mockado)
CAMBIO_URL=http://localhost:9090

# Timeout em milissegundos para a chamada externa
CAMBIO_TIMEOUT_MS=2000

# Tempo de espera no shutdown gracioso
SHUTDOWN_TIMEOUT_S=15

# Diretório das migrations SQL
MIGRATION_PATH=migrations

# Prefixo da API
API_PREFIX=/api/v1
